# IPv4-адрес RFID-ридера. Замените тестовый адрес на адрес устройства.
READER_HOST=192.0.2.10

# TCP-порт Hopeland SDK.
READER_PORT=9090

# Максимальное ожидание ответа ридера во время health-check, в секундах.
HEALTH_TIMEOUT_SECONDS=5

# Путь к журналу относительно директории приложения.
LOG_FILE=logs/whitelist_monitor.log

# Путь к файлу разрешённых EPC относительно директории приложения.
WHITELIST_FILE=whitelist.txt

# Минимальная пауза перед повторной реакцией на один EPC, в миллисекундах.
COOLDOWN_MS=2000

# Количество звуковых сигналов при совпадении EPC с whitelist.
SOUND_COUNT=3

# Задержка перед выключением каждого сигнала, в миллисекундах.
SOUND_DURATION_MS=50

# Пауза между звуковыми сигналами, в миллисекундах.
SOUND_INTERVAL_MS=150
